# ATLAS DataGob API persistence configuration
ATLAS_DEMAND_REPOSITORY=local_json
ATLAS_DEMAND_BACKLOG_PATH=data/runtime/demand_backlog.json
ATLAS_DEMO_SEED_PATH=data/demo/demand_backlog_seed.json

# Optional managed persistence adapter.
# ATLAS_DEMAND_REPOSITORY=firestore
# ATLAS_FIRESTORE_PROJECT=your-gcp-project-id
# ATLAS_FIRESTORE_DATABASE=(default)
# ATLAS_FIRESTORE_COLLECTION=atlas_datagob_demands

# Authorization readiness.
ATLAS_AUTH_MODE=disabled
# Example roles for ATLAS_AUTH_MODE=header:
# viewer,data_owner,data_steward,data_architect,committee_member,executive,platform_admin

# Feature 54 · Gemini ADK Conversational Governed Intake.
# Production uses Vertex AI through Application Default Credentials / Cloud Run service identity.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
ATLAS_INTAKE_MODEL=gemini-2.5-flash

# Feature 59 · reusable AgentOps / FinOps telemetry.
# Disabled by default so observability can be enabled explicitly per environment.
ATLAS_AGENTOPS_ENABLED=false
ATLAS_AGENTOPS_DATASET=agentops
# Optional fully-qualified override:
# ATLAS_AGENTOPS_LLM_USAGE_TABLE=your-gcp-project-id.agentops.agent_llm_usage
ATLAS_ENVIRONMENT=dev

# Versioned governance JSON catalog.
# Local/CI can use data/governance as fallback with REQUIRE_GCS=false.
# Production should configure the bucket and REQUIRE_GCS=true so ATLAS fails closed
# instead of silently evaluating a local catalog.
# ATLAS_GOVERNANCE_BUCKET=your-governance-bucket
ATLAS_GOVERNANCE_PREFIX=atlas-governance
ATLAS_GOVERNANCE_REQUIRE_GCS=false
