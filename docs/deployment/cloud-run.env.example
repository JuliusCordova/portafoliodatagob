# ATLAS DataGob Cloud Run deployment variables
# Copy this file to a local shell script or export variables directly in Cloud Shell.

export ATLAS_GCP_PROJECT="proyectopersonal-480420"
export ATLAS_GCP_REGION="us-central1"
export ATLAS_ARTIFACT_REPOSITORY="atlas-datagob"
export ATLAS_IMAGE_TAG="latest"

# API service
export ATLAS_API_SERVICE="atlas-datagob-api"
export ATLAS_API_IMAGE="atlas-datagob-api"
export ATLAS_API_SERVICE_ACCOUNT="atlas-datagob-api@${ATLAS_GCP_PROJECT}.iam.gserviceaccount.com"

# Persistence
export ATLAS_DEMAND_REPOSITORY="firestore"
export ATLAS_FIRESTORE_PROJECT="${ATLAS_GCP_PROJECT}"
export ATLAS_FIRESTORE_DATABASE=""
export ATLAS_FIRESTORE_COLLECTION="demand_backlog"

# API authorization
# disabled keeps local/smoke demo simple.
# header requires X-ATLAS-USER and X-ATLAS-ROLES propagated by Web or a gateway.
export ATLAS_AUTH_MODE="disabled"

# CORS for API. Replace with the Web Cloud Run URL after first deploy.
export ATLAS_ALLOWED_ORIGINS="http://localhost:3000"
export ATLAS_ALLOWED_ORIGIN_REGEX="https://.*\\.run\\.app"

# Web service
export ATLAS_WEB_SERVICE="atlas-datagob-web"
export ATLAS_WEB_IMAGE="atlas-datagob-web"
export ATLAS_WEB_SERVICE_ACCOUNT="atlas-datagob-web@${ATLAS_GCP_PROJECT}.iam.gserviceaccount.com"

# Replace with the API Cloud Run URL after API deploy.
export ATLAS_INTERNAL_API_BASE="https://REPLACE_WITH_API_URL"

# Web identity propagation
# disabled: no identity headers are sent to API.
# static: sends demo identity/roles from variables below.
# passthrough: forwards X-ATLAS-USER/X-ATLAS-ROLES or IAP email.
export ATLAS_WEB_IDENTITY_MODE="disabled"
export ATLAS_WEB_DEMO_USER="demo.operator@atlas.local"
export ATLAS_WEB_DEMO_ROLES="data_steward,committee_member,executive"

# Demo option. Use false for private services, true for public demo.
export ATLAS_ALLOW_UNAUTHENTICATED="true"

# Standard cloud smoke URLs.
export ATLAS_API_URL="https://REPLACE_WITH_API_URL"
export ATLAS_WEB_URL="https://REPLACE_WITH_WEB_URL"
export ATLAS_SMOKE_ALLOW_DEMO_RESET="false"

# Authenticated smoke. Use after API ATLAS_AUTH_MODE=header and Web ATLAS_WEB_IDENTITY_MODE=static or passthrough.
export ATLAS_AUTH_SMOKE_EXPECT_ENFORCED="true"
export ATLAS_AUTH_SMOKE_ALLOWED_USER="steward@example.com"
export ATLAS_AUTH_SMOKE_ALLOWED_ROLES="data_steward,committee_member,executive"
export ATLAS_AUTH_SMOKE_DENIED_USER="viewer@example.com"
export ATLAS_AUTH_SMOKE_DENIED_ROLES="viewer"
export ATLAS_AUTH_SMOKE_ALLOW_DEMO_RESET="false"

# Controlled pilot execution orchestrator.
# Keep deploy false for evidence-only reruns. Set true only when you want to update Cloud Run services.
export ATLAS_PILOT_EXECUTE_DEPLOY="false"
export ATLAS_PILOT_RUN_STANDARD_SMOKE="true"
export ATLAS_PILOT_RUN_AUTH_SMOKE="true"
export ATLAS_PILOT_GENERATE_EVIDENCE="true"
export ATLAS_PILOT_EVIDENCE_DIR="docs/deployment/evidence/generated/manual-run"

# Release candidate promotion gate.
# Set these only after CI, deploy, smoke, ops readiness and evidence collection are complete.
export ATLAS_RC_ID="atlas-datagob-rc-YYYYMMDD"
export ATLAS_RC_API_REVISION="REPLACE_WITH_API_REVISION"
export ATLAS_RC_WEB_REVISION="REPLACE_WITH_WEB_REVISION"
export ATLAS_RC_CI_STATUS="pass"
export ATLAS_RC_CONTAINER_STATUS="pass"
export ATLAS_RC_STANDARD_SMOKE_STATUS="pass"
export ATLAS_RC_AUTH_SMOKE_STATUS="pass"
export ATLAS_RC_OPS_READINESS_STATUS="pass"
export ATLAS_RC_AUTH_MODE_STATUS="pass"
export ATLAS_RC_PERSISTENCE_STATUS="pass"
export ATLAS_RC_ROLLBACK_PLAN_STATUS="pass"
export ATLAS_RC_EVIDENCE_PATH="docs/deployment/evidence/generated/manual-run"
export ATLAS_RC_APPROVER="REPLACE_WITH_APPROVER"
export ATLAS_RC_GATE_OUTPUT="data/runtime/release_candidate_gate_report.md"
